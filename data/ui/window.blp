using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow hello {
  title: "Tegami";
  default-width: 720;
  default-height: 480;

  Gtk.Box {
    orientation: vertical;
    spacing: 12;
    halign: center;
    valign: center;

    Gtk.Label {
      label: "Hello, Tegami!";
      css-classes: ["title-1"];
    }
  }
}